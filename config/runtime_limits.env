# AeroEyes runtime limits for Jetson Xavier NX (16 GB).
# Values are intentionally conservative because the flight controller and
# camera pipeline share the device with inference.
AEROEYES_DEVICE=cuda:0
AEROEYES_PRECISION=fp16
AEROEYES_MAX_MODEL_PARAMS=50000000
AEROEYES_MAX_INFERENCE_WIDTH=1280
AEROEYES_MAX_INFERENCE_HEIGHT=720
AEROEYES_TARGET_FPS=15
AEROEYES_MAX_RAM_MB=4096
AEROEYES_MAX_BATCH_SIZE=1
AEROEYES_MAX_REFERENCE_IMAGES=3
AEROEYES_MAX_QUEUE_SIZE=2
AEROEYES_MAX_INFERENCE_LATENCY_MS=100
AEROEYES_MAX_VIDEO_BUFFER_SECONDS=2

# Keep CPU-side parallelism bounded so inference cannot starve flight services.
OMP_NUM_THREADS=4
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
CUDA_DEVICE_MAX_CONNECTIONS=1
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128
